def log(msg):
    """日志走 stderr, 绝不污染 stdout 协议流"""
    print(f"[zcode-acp] {msg}", file=sys.stderr, flush=True)


def load_zcode_credentials():
    """从 v2/config.json 动态读取凭证 (不明文存储)。

    NOTE: 本函数源自 shared/credentials.py (权威实现), 修改时请同步。
    """
    try:
        with open(ZCODE_CREDS_PATH) as f:
            cfg = json.load(f)
    except FileNotFoundError:
        return {}  # 未配置凭证文件: 正常静默降级 (走纯环境变量, 不算故障)
    except Exception as e:
        # 整体 review P2-4: 文件存在但权限错误/JSON 损坏 → 显式警告,
        # 让用户能区分「没配凭证」与「凭证文件损坏」(此前一律打成普通 log 难察觉)
        log(f"⚠ 凭证文件存在但读取失败 ({ZCODE_CREDS_PATH}): {e}; 回退纯环境变量")
        return {}
    try:
        for _pid, p in cfg.get("provider", {}).items():
            if p.get("enabled"):
                opts = p.get("options", {})
                models = p.get("models", {})
                return {
                    "ZCODE_MODEL": next(iter(models)) if models else "GLM-5.3",
                    "ZCODE_BASE_URL": opts.get("baseURL", ""),
                    "ANTHROPIC_API_KEY": opts.get("apiKey", ""),
                }
    except Exception as e:
        log(f"⚠ 凭证文件结构异常 ({ZCODE_CREDS_PATH}): {e}; 回退纯环境变量")
    return {}


def _merge_env_with_creds(creds):
    """合并 config 凭证与环境变量: 显式非空 env 优先, 空串视为未设置;
    且自动检测/自愈 App 注入的残留 baseURL (issue #3)。

    源自 shared/credentials.py.merge_env_with_creds (单文件可独立运行故内嵌)。
    残留检测: env 的 ZCODE_BASE_URL 若是 config 里"另一个 provider"的官方 endpoint
    (App 切换 plan 后的残留), 自愈用 config 值; 用户自建 endpoint 则尊重 env。
    """
    merged = {**os.environ, **creds}
    for k in ("ZCODE_MODEL", "ZCODE_BASE_URL", "ANTHROPIC_API_KEY"):
        v = os.environ.get(k)
        if v:  # 仅非空才覆盖
            merged[k] = v
    # 残留检测
    env_bu = os.environ.get("ZCODE_BASE_URL", "")
    config_bu = creds.get("ZCODE_BASE_URL", "")
    if env_bu and config_bu and env_bu != config_bu:
        all_hosts = set()
        try:
            with open(ZCODE_CREDS_PATH) as _f:
                _cfg = json.load(_f)
            for _p in _cfg.get("provider", {}).values():
                _bu = _p.get("options", {}).get("baseURL", "")
                if _bu:
                    try:
                        _h = urlparse(_bu)
                        if _h.hostname:
                            all_hosts.add(f"{_h.scheme}://{_h.netloc}" if _h.scheme else _h.netloc)
                    except Exception:
                        pass
            _eh = urlparse(env_bu)
            env_host = f"{_eh.scheme}://{_eh.netloc}" if (_eh.scheme and _eh.hostname) else None
            _ch = urlparse(config_bu)
            config_host = f"{_ch.scheme}://{_ch.netloc}" if (_ch.scheme and _ch.hostname) else None
        except Exception:
            env_host = config_host = None
        # env host 等于某 config provider host, 但不等于 enabled 那个 → 残留
        if env_host and config_host and env_host != config_host and env_host in all_hosts:
            merged["ZCODE_BASE_URL"] = config_bu
            log(f"⚠ ZCODE_BASE_URL 残留检测: env='{env_bu}' 是 config 里另一个 provider "
                f"的 endpoint, 与 enabled provider (config='{config_bu}') 不一致。已自动用 "
                f"config 值 (旧 plan 残留)。")
    return merged


# ============================================================
# ZCode app-server 的 client 封装
# ============================================================
class ZCodeBackend:
    """管理 zcode app-server 子进程, 后台 reader 线程分发消息。

    消息分四种, 由后台 _reader_loop 读取并路由:
      - 响应 (有 id 无 method):        → _response_queues[id] 的 Queue
      - server→client 反向调用 (0.16+): → _handle_server_request 立即应答
      - session/event 推送:            → 当前 _event_listener 的 Queue
      - state.updated patch (0.16+):   → 合并进 _state_projections 状态投影

    协议模式 (protocol_mode): 启动时 _detect_protocol() 一次性探测并缓存。
      "legacy" = ≤0.15 旧协议服务端; "v16" = 0.16+ 新协议服务端。
    """

    def __init__(self):
        # 显式非空环境变量优先 (issue #3 子项2): ZCODE_MODEL=xxx 临时覆盖生效,
        # 但空串 env 视为未设置 (保留 config 值, 避免误清空)。
        env = _merge_env_with_creds(load_zcode_credentials())
        self.proc = subprocess.Popen(
            [ZCODE_BIN, "app-server", "--stdio"],
            stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
            text=True, bufsize=1, env=env,
        )
        # send 与 close 用同一把锁保护子进程管道
        self._send_lock = threading.Lock()
        # 响应路由: msg_id → Queue; request() 注册后读, 收到后清理
        self._response_queues = {}
        self._resp_lock = threading.Lock()
        # 通用 notification 队列 (非 session/event 的 notification)
        self._notification_queue = queue.Queue()
        # 当前事件监听器: {zcode_sid: EventStreamListener}
        self._event_listeners = {}
        self._listeners_lock = threading.Lock()
        # prompt/enhance 异步 job 的 result 通知路由: requestId → Queue
        # (3.3.0+): server 完成 enhance job 后推送 prompt/enhance/result notification,
        # reader 按 requestId 路由到对应等待中的 start 调用 (仿 _response_queues 模式)
        self._enhance_result_queues = {}
        self._enhance_lock = threading.Lock()
        # 协议探测 (0.16+): None=未探测; 探测期间无 id 的协议级错误帧 (兜底;
        # 0.16+ 的信封拒绝帧实测带固定 id "invalid-message") 入 _protocol_error_queue
        self.protocol_mode = None        # "legacy" | "v16" (探测后缓存)
        self.protocol_version = None     # session/create 返回的 protocol.version (0.16+)
        # 探测判定是否有实锤: True=见过信封拒绝帧/旧协议回显; False=仅超时兜底
        # (zcode review P1-3: 超时判来的 v16 允许被 subscribe 失败推翻回退 legacy)
        self.protocol_confirmed = None
        self._probe_lock = threading.Lock()
        self._protocol_error_queue = queue.Queue()
        # 0.16+ state.updated 的 patch 合并投影: {zcode_sid: {status, mode, model, ...}}
        self._state_projections = {}
        self._state_lock = threading.Lock()
        # reader 线程健康标志: 退出后设 True, request() 快速失败而非慢速假死
        self._reader_dead = False
        self._reader_stop = False
        self._reader_thread = threading.Thread(target=self._reader_loop, daemon=True)
        self._reader_thread.start()
        log(f"已启动 zcode app-server (pid={self.proc.pid})")
        # 启动即一次性协议探测 (旧信封试探, 见 _detect_protocol), 结果缓存全程复用
        self._detect_protocol()

    def _reader_loop(self):
        """后台线程: 持续读 zcode stdout, 按消息类型分发到对应队列。"""
        while not self._reader_stop:
            try:
                line = self.proc.stdout.readline()
                if not line:
                    break  # 进程关闭
                line = line.strip()
                if not line:
                    continue
                try:
                    msg = json.loads(line)
                except json.JSONDecodeError:
                    continue
                method = msg.get("method")
                msg_id = msg.get("id")
                if msg_id is not None and method is None:
                    # 响应: 有 id 无 method → 路由到对应 Queue
                    with self._resp_lock:
                        q = self._response_queues.pop(msg_id, None)
                    if q is not None:
                        q.put(msg)
                    else:
                        # 没人等: 放通用队列兜底
                        self._notification_queue.put(msg)
                elif msg_id is not None and method is not None:
                    # 0.16+ server→client 反向调用 (如 session/requestRuntimePreferences):
                    # 必须应答, 否则 session/create|send 永久挂起 (实测)
                    self._handle_server_request(msg)
                elif method == "session/event":
                    # 事件推送: 路由到对应会话的 listener
                    ev = msg.get("params", {})
                    sid = ev.get("sessionId")
                    with self._listeners_lock:
                        listener = self._event_listeners.get(sid)
                    if listener is not None:
                        listener.handle_event(ev)
                    else:
                        # 没人监听: 忽略 (订阅是按需的)
                        pass
                elif method == "state.updated":
                    # 0.16+ 状态投影 patch → 合并进 _state_projections (供停滞检查;
                    # 不进 _notification_queue — 那里无消费者, 只会无界积压)
                    self._merge_state_patch(msg.get("params", {}))
                elif method == "prompt/enhance/result":
                    # (3.3.0+) enhance job 完成 notification: 按 requestId 路由到等待中的 start
                    params = msg.get("params", {})
                    rid = params.get("requestId")
                    with self._enhance_lock:
                        eq = self._enhance_result_queues.pop(rid, None)
                    if eq is not None:
                        eq.put(params)
                    else:
                        # 没人等 (start 未注册/已超时退出/已取消): 丢弃避免无界积压
                        # (Codex review P1-3: _notification_queue 无消费者, 积压会泄漏)
                        log(f"prompt/enhance/result (requestId={rid}) 无等待者, 丢弃")
                elif method is not None:
                    # 其他 notification (0.16+ 的 v4/telemetry/event 等): 忽略
                    # (v4/telemetry 高频且桥不消费, 入队只会无界积压)
                    pass
                elif "error" in msg:
                    # 无 id 无 method 的协议级错误帧 (兜底路径; 0.16+ 的信封拒绝帧
                    # 实测带固定 id "invalid-message", 由探测时注册的专用队列接收,
                    # 此队列仅防某版本发真正无 id 的错误帧)
                    if self.protocol_mode is None:
                        self._protocol_error_queue.put(msg)
                    else:
                        log(f"收到无 id 协议错误帧: {str(msg.get('error'))[:120]}")
                # 其余畸形帧: 忽略
            except Exception as e:
                log(f"reader 线程异常: {e}")
                break
        # reader 退出: 设标志, 后续 request() 快速失败而非慢速假死
        self._reader_dead = True
        # 清理所有等待中的响应队列, 让它们立即得到错误
        with self._resp_lock:
            for q in self._response_queues.values():
                q.put({"error": {"message": "zcode backend reader exited"}})
            self._response_queues.clear()
        # 同样清理等待中的 enhance result 队列, 防止 start 调用永久挂起
        with self._enhance_lock:
            for q in self._enhance_result_queues.values():
                q.put({"requestId": None, "status": "failed",
                       "errorMessage": "zcode backend reader exited"})
            self._enhance_result_queues.clear()
        log("reader 线程退出 (backend 已标记为 dead)")

    def register_event_listener(self, zcode_sid, listener):
        """注册事件监听器, 之后该 sid 的 session/event 会路由到它。"""
        with self._listeners_lock:
            # 整体 review P2-8: 同 sid 覆盖注册会静默丢前一个 listener (其事件
            # 从此无人消费)。当前调用方保证同 sid 串行 + finally 注销, 正常不触发;
            # 打告警防御未来引入同 session 并发 prompt 时丢事件难以排查
            if zcode_sid in self._event_listeners:
                log(f"⚠ register_event_listener: sid={zcode_sid} 已有 listener, "
                    f"覆盖注册 (前一个 listener 的事件将无人消费)")
            self._event_listeners[zcode_sid] = listener

    def unregister_event_listener(self, zcode_sid):
        """注销事件监听器。"""
        with self._listeners_lock:
            self._event_listeners.pop(zcode_sid, None)

    def register_enhance_listener(self, request_id):
        """注册 prompt/enhance result 监听, 返回用于等待 result 的 Queue。

        必须在发 prompt/enhance/start 之前调用 (时序: 先注册, 再 start),
        否则 start 返回与 result 推送之间到达的通知会进兜底队列被丢弃。

        返回 (queue, error): error 非 None 表示该 requestId 已有 pending listener
        (重复提交), 调用方应拒绝第二个 start (Codex review P1-2: 避免覆盖孤立旧等待者)。
        """
        q = queue.Queue()
        with self._enhance_lock:
            if request_id in self._enhance_result_queues:
                return None, f"duplicate requestId {request_id} (已有 pending enhance job)"
            self._enhance_result_queues[request_id] = q
        return q, None

    def unregister_enhance_listener(self, request_id):
        """注销 enhance result 监听 (超时/取消时清理)。"""
        with self._enhance_lock:
            self._enhance_result_queues.pop(request_id, None)

    def send(self, msg):
        """发一条消息给 zcode (无 jsonrpc 字段)"""
        with self._send_lock:
            self.proc.stdin.write(json.dumps(msg, ensure_ascii=False) + "\n")
            self.proc.stdin.flush()

    def readline(self, timeout=2.0):
        """[兼容旧调用] 从通用 notification 队列读一条消息。

        注: reader 线程模式下, 所有响应走 request(), 所有 notification 走队列。
        旧代码中 readline 直接读 stdout 的用法已被 request() 取代。
        """
        try:
            return self._notification_queue.get(timeout=timeout)
        except queue.Empty:
            return None

    def request(self, msg_id, method, params=None, timeout=30):
        """同步请求: 注册响应队列, 发送, 等待对应 id 的响应。

        期间到达的其他 notification 由 reader 线程异步分发到各自的队列,
        不会被本方法吞掉 (修复旧版 request 与事件推送的竞态)。
        """
        if params is None:
            params = {}
        # reader 已死: 快速失败, 不让调用方卡满 timeout
        if self._reader_dead:
            return {"error": {"message": "zcode backend reader exited (backend dead)"}}, []
        # 注册响应队列
        resp_q = queue.Queue()
        with self._resp_lock:
            self._response_queues[msg_id] = resp_q
        try:
            self.send({"id": msg_id, "method": method, "params": params})
        except (BrokenPipeError, OSError) as e:
            with self._resp_lock:
                self._response_queues.pop(msg_id, None)
            self._reader_dead = True
            return {"error": {"message": f"zcode backend pipe broken: {e}"}}, []
        try:
            resp = resp_q.get(timeout=timeout)
            return resp, []  # notifications 已由 reader 分发, 不再在这里收集
        except queue.Empty:
            with self._resp_lock:
                self._response_queues.pop(msg_id, None)
            return {"error": {"message": "timeout"}}, []

    def close(self):
        self._reader_stop = True
        try:
            self.proc.terminate()
            self.proc.wait(timeout=3)
        except Exception:
            self.proc.kill()
            # 整体 review P2-7: kill 后补 wait 收尸, 防子进程变僵尸残留
            try:
                self.proc.wait(timeout=2)
            except Exception:
                pass

    # ---------- 0.16+ 协议探测 / 反向调用应答 / 状态投影 ----------

    def _detect_protocol(self):
        """启动一次性协议探测 (≤0.15 旧协议 vs 0.16+ 新协议), 结果缓存全程只用一次。

        方法 (规格书 §1 + 实测复核): 以旧信封 (含 jsonrpc 键) 发 workspace/readState。
          - 0.16+ zod 校验拒收 jsonrpc 键 → -32600 invalid_union; 实测该错误帧的
            id 是固定占位符 "invalid-message" (非请求 id) → 判 "v16"
          - ≤0.15 理解信封 → 回显 probe id 的正常响应 (result 或非信封类 error) → "legacy"
          - 超时无法判定 → 暂按 "v16" 处理 (当前发行版; 且新协议代码路径对 0.15 亦兼容:
            信封/方法集一致, 反向调用 0.15 从不发, 已删方法 0.15 不会返 -32601),
            但标 protocol_confirmed=False (无实锤): 之后 subscribe 失败即推翻该判定,
            回退 legacy 走原有轮询降级 (zcode review P1-3; 防启动慢于 8s 的 ≤0.15
            server 被超时误判 v16 后 subscribe 门禁硬报错、完全不可用)
        """
        with self._probe_lock:
            if self.protocol_mode is not None:
                return  # 已探测过, 直接复用缓存
            if self._reader_dead:
                self.protocol_mode = "v16"  # 后端已死, 模式无实际影响; 取当前发行版
                # confirmed=True: 后端已死, 回退 legacy 轮询同样活不了, 不做无谓降级
                self.protocol_confirmed = True
                return
            # 字符串 probe id: 避开 bridge 的数字请求空间, 也避开 server 的 "server-N"
            # 固定值安全依赖: 全程只探一次 (_probe_lock + 结果缓存); 若未来引入
            # 重连重探, 需改为每次唯一 id 防与残留响应交错 (zcode review P3-3)
            probe_id = "bridge-probe-1"
            resp_q = queue.Queue()
            reject_q = queue.Queue()
            with self._resp_lock:
                self._response_queues[probe_id] = resp_q
                # 0.16+ 的信封拒绝帧带固定 id "invalid-message" (实测), 一并注册
                # 接收 — 否则会被当无主响应漏进 _notification_queue, 探测必超时
                self._response_queues["invalid-message"] = reject_q
            try:
                cwd = os.getcwd()
                self.send({
                    "jsonrpc": "2.0", "id": probe_id,
                    "method": "workspace/readState",
                    "params": {"workspace": {"workspacePath": cwd, "workspaceKey": cwd}},
                })
            except (BrokenPipeError, OSError) as e:
                with self._resp_lock:
                    self._response_queues.pop(probe_id, None)
                    self._response_queues.pop("invalid-message", None)
                self.protocol_mode = "v16"
                # confirmed=True: 管道已断, 回退 legacy 轮询同样发不出去, 保持硬门禁
                self.protocol_confirmed = True
                log(f"协议探测: 发送失败 ({e}), 按 0.16+ 新协议处理")
                return
            try:
                deadline = time.time() + 8
                while time.time() < deadline:
                    # (a) probe id 回显响应: 信封被理解 → 旧协议 (除非内容恰是信封拒绝)
                    try:
                        msg = resp_q.get(timeout=0.2)
                        self.protocol_mode = "v16" if self._is_envelope_reject(msg) else "legacy"
                        break
                    except queue.Empty:
                        pass
                    # (b) "invalid-message" 占位 id 的拒绝帧: 0.16+ 实测形态
                    try:
                        msg = reject_q.get_nowait()
                        self.protocol_mode = "v16" if self._is_envelope_reject(msg) else "legacy"
                        break
                    except queue.Empty:
                        pass
                    # (c) 兜底: 万一某版本发真正无 id 的孤儿错误帧
                    try:
                        orphan = self._protocol_error_queue.get_nowait()
                        if self._is_envelope_reject(orphan):
                            self.protocol_mode = "v16"
                            break
                        # 非信封错误的孤儿帧与探测无关, 丢弃继续等
                    except queue.Empty:
                        pass
                else:
                    self.protocol_mode = "v16"
                    # 超时兜底无实锤 → 未确认: subscribe 失败可推翻回退 legacy
                    # (见 docstring 与 _on_session_prompt 的回退分支)
                    self.protocol_confirmed = False
                    log("⚠ 协议探测超时, 暂按 0.16+ 处理 (未确认; subscribe 失败将回退旧协议)")
                # 从 while break 出来的都是实锤判定 (信封拒绝帧或旧协议回显) → 确认
                if self.protocol_confirmed is None:
                    self.protocol_confirmed = True
            finally:
                with self._resp_lock:
                    self._response_queues.pop(probe_id, None)
                    self._response_queues.pop("invalid-message", None)
            _unconfirmed = "" if self.protocol_confirmed else ", 超时兜底未确认"
            log(f"协议探测: mode={self.protocol_mode} "
                f"({'0.16+ 新协议' if self.protocol_mode == 'v16' else '≤0.15 旧协议'}"
                f"{_unconfirmed})")

    @staticmethod
    def _is_envelope_reject(msg):
        """判定响应/孤儿帧是否为 0.16+ 的信封拒绝 (-32600 / invalid_union)。"""
        err = msg.get("error") or {}
        if err.get("code") == -32600:
            return True
        # data.issues 里的 zod 细节 (invalid_union / unrecognized_keys: jsonrpc)
        blob = json.dumps(err.get("data", ""), ensure_ascii=False) + str(err.get("message", ""))
        return "invalid_union" in blob or "unrecognized_keys" in blob

    def _handle_server_request(self, msg):
        """应答 0.16+ server→client 反向调用。

        实测: session/create 与 session/send 都会反向请求
        session/requestRuntimePreferences (scope 分别为 runtime-materialization /
        user-execution), server 拿到应答才继续 — 旧版桥无此路径即卡死于此。
        写帧走 send() 的 _send_lock, 与 request() 的请求帧不会交错。
        """
        msg_id = msg.get("id")
        method = msg.get("method")
        # 本方法在 reader 线程内执行: send() 失败只记日志、不抛出也不 break — 这是
        # 设计意图 (reader 存活优先, 一次应答异常不能带走整个 reader)。代价是本次
        # 应答丢失后 server 侧该请求会空等到它自己超时 (桥无法挽救), 但 reader 继续
        # 分发后续帧, 其他请求不受影响 (整体 review P2-6: 注释与实际行为对齐)。
        if method == "session/requestRuntimePreferences":
            scope = msg.get("params", {}).get("scope", "?")
            log(f"  ← 应答 session/requestRuntimePreferences (scope={scope})")
            try:
                self.send({"id": msg_id, "result": dict(RUNTIME_PREFERENCES)})
            except Exception as e:
                log(f"  ← 应答发送失败 (忽略, reader 存活优先): {e}")
        else:
            # 未知反向调用: 应答 -32601, 避免 server 侧空等挂起
            log(f"  ← 未知 server→client 请求 {method}, 应答 -32601")
            try:
                self.send({"id": msg_id, "error": {
                    "code": -32601, "message": f"method not implemented by bridge: {method}"}})
            except Exception as e:
                log(f"  ← 应答发送失败 (忽略, reader 存活优先): {e}")

    def _merge_state_patch(self, params):
        """0.16+ state.updated: 把 patch 合并进会话状态投影 (供事件流停滞检查)。

        实测形态: {patch:{status,...}, reason, revision, scope, sessionId}。
        """
        sid = params.get("sessionId")
        patch = params.get("patch")
        if not sid or not isinstance(patch, dict):
            return
        with self._state_lock:
            # 整体 review P2-2: 投影跨 session 无清理 (reset_projection 只管当前
            # sid 的每 turn 入口), 且无 session 关闭钩 → 超上限 FIFO 淘汰最旧条目
            if sid not in self._state_projections \
                    and len(self._state_projections) >= _MAX_SESSION_STATES:
                evicted = next(iter(self._state_projections))
                self._state_projections.pop(evicted, None)
                log(f"⚠ state 投影超上限 ({_MAX_SESSION_STATES}), "
                    f"淘汰最旧 session: {evicted}")
            self._state_projections.setdefault(sid, {}).update(patch)

    def get_projection(self, zcode_sid):
        """取 state.updated 合并出的状态投影副本 (无则 None)。"""
        with self._state_lock:
            proj = self._state_projections.get(zcode_sid)
            return dict(proj) if proj else None

    def reset_projection(self, zcode_sid):
        """新 turn 入口清掉该会话的状态投影 (防跨 turn 陈旧; zcode review P1-1)。

        核实结论 (该条为误报, 此处是防御): 投影唯一写入点是 _merge_state_patch
        (reader 的 state.updated 路由), subscribe/create 快照从不播种 (subscribe
        快照只取 contextWindow 进 listener); Wave 2 reviewer-1 实测 0.16.1 turn
        期间 state.updated 只有 {status:running} (prompt_started) 与
        {mode,model,...} (prompt_completed) 两种 patch, 从不发 status:idle —
        跨 turn 残留最多卡在 running, 「残留 idle 投影致 _run_event_turn 停滞
        检查提前收尾」的竞态在 0.16.1 不可达。仍清理: 投影只服务停滞检查, 重置
        零成本, 未来版本若补发 idle patch 也读不到上一 turn 的旧值。
        """
        with self._state_lock:
            self._state_projections.pop(zcode_sid, None)


# ============================================================
# TurnMonitor: 把轮询循环抽离, 每次返回完整快照 (不只 status)
# ============================================================
class TurnMonitor:
    """封装 session/read 轮询, 提供完整 projection 快照。

    解决 MVP 里轮询只取 status 就 break、丢弃其他字段的问题。
    """

    def __init__(self, backend, zcode_sid, bridge):
        self.backend = backend
        self.zcode_sid = zcode_sid
        self.bridge = bridge  # 用于 _next_id / _drain_inbox

    def poll_once(self):
        """发一次 session/read, 返回 projection dict 或 None。

        注: reader 线程模式下用 request() 拿响应 (不再直接 readline)。
        """
        poll_id = self.bridge._next_id()
        resp, _ = self.backend.request(poll_id, "session/read",
                                       {"sessionId": self.zcode_sid}, timeout=5)
        if "error" not in resp:
            return resp.get("result", {}).get("projection", {})
        return None


# ============================================================
# EventStreamListener: 订阅 zcode 事件流 (session/subscribe + session/event)
# ============================================================
# 新版 ZCode (CLI 0.14.8+) 增加了事件推送机制:
#   session/subscribe(deliveryKind=desktop-continuous) 开启推送
#   之后服务器主动发 {method:"session/event", params:{type, payload, seq, ...}}
#   流式文本通过 model.streaming 事件 (kind=text_delta) 逐段推送, 不再等 turn 结束。
class EventStreamListener:
    """订阅 zcode 事件流, 把 session/event 推送入队供主循环消费。

    用法:
      listener = EventStreamListener(backend, zcode_sid)
      sub_result = listener.subscribe(msg_id)  # 订阅 (msg_id 为请求 id), 返回 result dict (或 None 降级)
      if sub_result is not None:
          backend.register_event_listener(zcode_sid, listener)
          # ... 主循环里 listener.poll_event() 取事件 ...
          backend.unregister_event_listener(zcode_sid)
    """

    def __init__(self, backend, zcode_sid):
        self.backend = backend
        self.sid = zcode_sid
        self.last_seq = 0               # seq 游标
        self.subscribed = False
        self.context_window = 0         # 订阅快照的 projection.contextWindow (usage size 兜底)
        self._event_queue = queue.Queue()

    def subscribe(self, msg_id):
        """调 session/subscribe 拿初始快照 + eventSeq 水位线。

        deliveryKind 为 0.16+ 必填 (枚举 desktop-continuous/web-remote-replayable,
        实测 desktop-continuous 可用; 旧版也接受该参数)。

        返回: 整个 result dict (含 eventSeq/snapshot) 或 None (失败, 调用方应降级)。
        注意以"是否 None"判成败, 不以 snapshot 有无 — 服务端可能不附快照。
        """
        resp, _ = self.backend.request(msg_id, "session/subscribe", {
            "sessionId": self.sid,
            "deliveryKind": "desktop-continuous",
            "includeSnapshot": True,
            "afterSeq": 0,
        }, timeout=10)
        if "error" in resp:
            # subscribe 失败: 实锤 v16 由调用方直接报错 (无轮询降级); 旧协议降级。
            # 例外 (P1-3): 探测超时兜底判的 v16 (protocol_confirmed=False) 会被
            # 调用方回退 legacy 并降级轮询, 日志同样提示降级。
            hard_v16 = getattr(self.backend, "protocol_mode", "legacy") == "v16" \
                and getattr(self.backend, "protocol_confirmed", True)
            demote = "" if hard_v16 else " (降级轮询)"
            log(f"  session/subscribe 失败{demote}: {resp['error'].get('message', '')}")
            return None
        result = resp.get("result", {})
        self.last_seq = result.get("eventSeq", 0)
        # 0.16.1 turn.completed.usage 只有 token 明细, 无 contextWindow; 从订阅快照
        # 缓存 (实测 1000000), 供 EventTranslator 兜底 usage_update 的 size
        snap = result.get("snapshot") or {}
        self.context_window = (snap.get("projection") or {}).get("contextWindow", 0) or 0
        self.subscribed = True
        log(f"  ✓ session/subscribe 成功 (eventSeq={self.last_seq})")
        return result

    def handle_event(self, event):
        """被 ZCodeBackend._reader_loop 调用: 把 session/event params 入队。"""
        seq = event.get("seq", self.last_seq)
        if seq > self.last_seq:
            self.last_seq = seq
        self._event_queue.put(event)

    def poll_event(self, timeout=0.5):
        """取一条事件, 超时返回 None。"""
        try:
            return self._event_queue.get(timeout=timeout)
        except queue.Empty:
            return None


# ============================================================
# EventTranslator: 把 zcode 事件 → ACP 事件 dict (复用 ProjectionDiffer 的 kind)
# ============================================================
# 实测 zcode 事件类型 (session/event params.type):
#   turn.started      → 标记 turn 启动
#   model.streaming   → 流式文本/推理增量 (payload.kind=text_delta/reasoning_delta)
#   tool.updated      → 工具调用 (payload.kind=scheduled/started/progress/result/batch)
#   turn.completed    → turn 完成 (payload.usage/tokenCount/resultType)
#   turn.failed       → turn 失败 (终止帧, 之后无 turn.completed; 0.16.1 实测无
#                       resultType 字段, 错误详情在 payload.error{type,code,message})
class EventTranslator:
    """把 zcode session/event 翻译成 ACP 事件 dict 列表。

    输出格式与 ProjectionDiffer.diff() 一致 (kind 标识), 可直接喂给 _dispatch_event。
    """

    # zcode tool 名 → ACP ToolKind (复用 ProjectionDiffer 的映射)
    TOOL_KIND_MAP = {
        "Bash": "execute", "bash": "execute",
        "Edit": "edit", "Write": "edit", "edit": "edit", "write": "edit",
        "Read": "read", "read": "read",
        "Grep": "search", "grep": "search", "Glob": "search",
        "WebFetch": "fetch", "WebSearch": "fetch", "web_search": "fetch",
    }

    def __init__(self):
        self.turn_started = False
        self.turn_done = False
        self.turn_result_type = None     # success/cancelled/error_... (仅 turn.completed 携带)
        self.turn_failed = False         # turn.failed 终止帧标记 (0.16.1 无 resultType, 不模式匹配)
        self.turn_error = None           # turn.failed 的错误文案 (从 payload.error 提取)
        self.context_window = 0          # subscribe 快照缓存的 contextWindow (usage size 兜底)
        self._seen_tool_ids = set()      # 已通知过的 toolCallId (scheduled)
        self._tool_names = {}             # call_id → tool_name (result 事件不带 toolName)

    def translate(self, event):
        """翻译一条 zcode event → ACP 事件 dict 列表 (可能为空)。

        Args:
            event: session/event 的 params (含 type, payload, seq)。
        Returns:
            list of event dict (kind 格式, 同 ProjectionDiffer)。

        判别字段双形态兼容: 0.16.1 实测 type 在 params 顶层 (payload 不含);
        payload.type 仅在 session.updated 里作子类型出现, 故顶层优先, payload 兜底。
        """
        payload = event.get("payload") or {}
        etype = event.get("type") or payload.get("type", "")
        results = []

        if etype == "turn.started":
            self.turn_started = True
            log("  [event] turn.started")

        elif etype == "model.streaming":
            results.extend(self._translate_streaming(payload))

        elif etype == "tool.updated":
            results.extend(self._translate_tool(payload))

        elif etype == "turn.completed":
            self.turn_done = True
            self.turn_result_type = payload.get("resultType", "success")
            results.extend(self._translate_turn_done(payload))
            log(f"  [event] turn.completed (resultType={self.turn_result_type})")

        elif etype == "turn.failed":
            # 0.16.1 实测: turn.failed 是终止帧 (之后无 turn.completed), payload
            # 无 resultType 字段, 错误详情在 payload.error{type,code,message,...}。
            # 无条件判失败 (turn_failed 标记驱动, 不编造 resultType, 不做模式匹配)。
            # 只取 message/type/code 入文案与日志 — 不碰 detail/stack (可能含敏感回显)。
            self.turn_done = True
            self.turn_failed = True
            err = payload.get("error") or {}
            if not isinstance(err, dict):  # 防御: error 为字符串等非 dict 形态时兜底 (reviewer-1 N1)
                err = {"message": str(err)}
            self.turn_error = (err.get("message") or err.get("type")
                               or err.get("code") or "unknown error")
            log(f"  [event] turn.failed ({self.turn_error})")

        elif etype == "session.titleUpdated":
            # 标题更新: 不产出 ACP 事件, 转 stderr 日志 (规格书 §4)
            log(f"  [event] session.titleUpdated → {payload.get('title', '')!r}")

        # 其他类型 (session.updated/rewind.triggered/turn.steerQueued 等) 不产出 ACP 事件
        return results

    def _translate_streaming(self, payload):
        """model.streaming → TextDelta / ReasoningDelta (逐段增量)。

        0.16.1 实测还会出现 tool_input_start/delta/end 与 tool_call 等 kind
        (工具输入流): 刻意忽略 — 工具生命周期由 tool.updated 承载, 不重复映射。
        """
        results = []
        kind = payload.get("kind", "")
        delta = payload.get("delta", "")
        if not delta:
            return results
        if kind == "text_delta":
            results.append({"kind": "TextDelta", "text": delta})
        elif kind == "reasoning_delta":
            results.append({"kind": "ReasoningDelta", "text": delta})
        return results

    def _translate_tool(self, payload):
        """tool.updated → ToolCallNew / ToolCallUpdate。"""
        results = []
        tkind = payload.get("kind", "")
        call_id = payload.get("toolCallId", "")
        tool_name = payload.get("toolName", "")

        if tkind == "scheduled":
            if call_id and call_id not in self._seen_tool_ids:
                self._seen_tool_ids.add(call_id)
                self._tool_names[call_id] = tool_name
                acp_kind = self.TOOL_KIND_MAP.get(tool_name, "execute")
                results.append({
                    "kind": "ToolCallNew",
                    "call_id": call_id,
                    "tool": tool_name or "unknown",
                    "acp_kind": acp_kind,
                    "status": "pending",
                })

        elif tkind == "started":
            if call_id:
                results.append({
                    "kind": "ToolCallUpdate",
                    "call_id": call_id,
                    "status": "in_progress",
                })

        elif tkind == "progress":
            if call_id:
                # progress 事件含 stdoutTail/stderrTail (实时输出)
                output = payload.get("stdoutTail", "") or payload.get("stderrTail", "")
                results.append({
                    "kind": "ToolCallUpdate",
                    "call_id": call_id,
                    "status": "in_progress",
                    "output": output,
                })

        elif tkind == "result":
            if call_id:
                raw = payload.get("result", "")
                # 0.16.1 实测 result 为对象 {success, content, perf, ...}; 0.15 为字符串
                status = "completed"
                if isinstance(raw, dict):
                    output = raw.get("content") or raw.get("error") or ""
                    if raw.get("success") is False:
                        status = "failed"
                else:
                    output = raw
                results.append({
                    "kind": "ToolCallUpdate",
                    "call_id": call_id,
                    "status": status,
                    "output": str(output)[:2000] if output else "",
                })

        elif tkind == "error":
            if call_id:
                results.append({
                    "kind": "ToolCallUpdate",
                    "call_id": call_id,
                    "status": "failed",
                    "output": payload.get("error", ""),
                })

        elif tkind == "batch":
            # batch: 多个工具一起完成。payload 含 toolCallIds[] + successCount/errorCount。
            # 实测 zcode 通常也会逐个发 result, 但作为兜底: 若 batch 里有未完成的 call_id,
            # 补发 completed, 防止工具在编辑器里永远卡在 in_progress。
            batch_ids = payload.get("toolCallIds", [])
            error_count = payload.get("errorCount", 0)
            for bid in batch_ids:
                # 只补发 scheduled 过的 (避免给未知 id 发幽灵事件)
                if bid in self._seen_tool_ids:
                    results.append({
                        "kind": "ToolCallUpdate",
                        "call_id": bid,
                        "status": "failed" if error_count > 0 else "completed",
                    })
        return results

    def _translate_turn_done(self, payload):
        """turn.completed → UsageDelta (最终用量)。"""
        results = []
        usage = payload.get("usage") or {}
        token_count = payload.get("tokenCount", 0)
        used = usage.get("totalTokens") or token_count or 0
        # 0.16.1 实测 turn.completed.usage 只有 token 明细 (source/modelRequestCount/
        # input/output/total/cache*/reasoning/web*), 无 contextWindow → 用 subscribe
        # 成功时缓存的快照 projection.contextWindow 兜底 size; 无缓存保持 0
        size = usage.get("contextWindow", 0) or self.context_window
        if size > 0 or used > 0:
            results.append({"kind": "UsageDelta", "used": used, "size": size})
        return results


# ============================================================
# ProjectionDiffer: 对比两次快照, 输出事件列表
# ============================================================
# 事件类型 (dataclass 太重, 用简单 dict + "kind" 标识)
# ToolCallNew:    {kind, call_id, tool, status, input, output}
# ToolCallUpdate: {kind, call_id, status, output}
# UsageDelta:     {kind, used, size}
# TextDelta:      {kind, text}
# ReasoningDelta: {kind, text}
# PlanUpdate:     {kind, entries:[{content,status,priority}]}
# FilesChanged:   {kind, files:[str]}

class ProjectionDiffer:
    """对比两次快照差异, 产出事件列表。

    快照来源: session/read 的 projection (含 activeToolCalls/totalTokenCount 等)
    辅以 session/messages 的 parts (text/tool/reasoning/patch/todo)。
    """

    # zcode tool 名 → ACP ToolKind 映射
    TOOL_KIND_MAP = {
        "Bash": "execute", "bash": "execute",
        "Edit": "edit", "Write": "edit", "edit": "edit", "write": "edit",
        "Read": "read", "read": "read",
        "Grep": "search", "grep": "search", "Glob": "search",
        "WebFetch": "fetch", "WebSearch": "fetch", "web_search": "fetch",
    }

    # zcode tool state.status → ACP ToolCallStatus
    TOOL_STATUS_MAP = {
        "pending": "pending", "running": "in_progress",
        "completed": "completed", "error": "failed",
    }

    def __init__(self):
        self._seen_tool_ids = set()      # 已通知过的 toolCallId
        self._last_tool_status = {}      # call_id → 上次 status
        self._last_usage = None          # 上次 totalTokenCount
        self._seen_message_ids = set()   # 已处理过的 message id (避免多轮/resume 误发历史)
        self._last_plan_sig = "__none__" # 上次 plan 签名 (初始 "__none__" 让首次空 todos 也能发出清空事件)
        self._seen_patch_hashes = set()  # 已通知过的 patch hash
        self.emitted_text_this_turn = False  # 本轮是否已发过 TextDelta (兜底判断用)

    def mark_seen(self, messages):
        """把给定 messages 标记为已见 (建立 baseline, 避免误发历史)。

        只标记带 info.id/id 的消息: zcode 协议保证真实消息 id 存在 (实测),
        历史消息都会被覆盖; 无 id 消息 (测试桩/畸形数据) 不入 baseline, 由
        diff 首次发出时按 fallback 键自行去重 (P3 防护不变)。
        """
        for m in messages:
            info = m.get("info", {}) if isinstance(m.get("info"), dict) else {}
            key = info.get("id") or m.get("id")
            if key:
                self._seen_message_ids.add(key)

    @staticmethod
    def _message_dedup_key(m):
        """生成消息去重键。优先 info.id; 无 id 时用 (role, parts 内容签名) 做 fallback。

        修复 P3: 原代码无 id 消息每次 diff 都重发。zcode 协议保证 info.id 存在
        (实测验证), 但 fallback 让代码对边界情况也安全, 且注释与行为一致。
        """
        info = m.get("info", {}) if isinstance(m.get("info"), dict) else {}
        msg_id = info.get("id") or m.get("id")
        if msg_id:
            return msg_id
        # fallback: role + parts 内容签名 (无 id 时用, 避免重复)
        role = info.get("role", "?")
        parts = m.get("parts", [])
        try:
            parts_sig = json.dumps(parts, ensure_ascii=False, sort_keys=True)[:200]
        except (TypeError, ValueError):
            parts_sig = str(parts)[:200]
        return f"__fallback::{role}::{parts_sig}"

    def reset_turn(self):
        """每个 turn 开始时重置"本轮"标记 (不重置 _seen_message_ids)。"""
        self.emitted_text_this_turn = False

    def diff(self, prev_snapshot, cur_snapshot):
        """对比两次快照。snapshot = {projection, messages, todos}。

        返回事件列表 (可能为空)。

        关键: 只处理"本轮新增"的消息 (按 message id 去重), 避免多轮/resume 时
        把历史 assistant 回复当新增重发。text/reasoning 按整条消息发 (zcode 快照式,
        每条 assistant 消息是完整的, 不存在跨 snapshot 增量)。
        """
        events = []
        cur_proj = cur_snapshot.get("projection", {}) if cur_snapshot else {}
        cur_msgs = cur_snapshot.get("messages", []) if cur_snapshot else []

        # 1. usage_update: totalTokenCount / contextWindow 变化
        used = cur_proj.get("totalTokenCount", 0)
        size = cur_proj.get("contextWindow", 0)
        if self._last_usage is None or used != self._last_usage:
            if size > 0:  # 首次或变化才发
                events.append({"kind": "UsageDelta", "used": used, "size": size})
            self._last_usage = used

        # 2. 只遍历"本轮新增"的 messages (去重, 修复 P1.1 误发历史 + P3 无 id 重复)
        for m in cur_msgs:
            dedup_key = self._message_dedup_key(m)
            # 按 dedup_key 去重: 优先 info.id; 无 id 时用 (role, parts 内容) 做 fallback
            if dedup_key and dedup_key in self._seen_message_ids:
                continue
            if dedup_key:
                self._seen_message_ids.add(dedup_key)
            role = m.get("info", {}).get("role")
            for p in m.get("parts", []):
                if not isinstance(p, dict):
                    continue
                ptype = p.get("type")
                if ptype == "tool":
                    events.extend(self._diff_tool_part(p))
                elif ptype == "text" and role == "assistant":
                    # 整条 text 发送 (新消息才到这里, 已按 id 去重)
                    text = p.get("text", "")
                    if text.strip():
                        events.append({"kind": "TextDelta", "text": text})
                        self.emitted_text_this_turn = True
                elif ptype == "reasoning":
                    text = p.get("text", "")
                    if text.strip():
                        events.append({"kind": "ReasoningDelta", "text": text})
                elif ptype == "patch":
                    ph = p.get("hash")
                    if ph and ph not in self._seen_patch_hashes:
                        self._seen_patch_hashes.add(ph)
                        events.append({"kind": "FilesChanged", "files": p.get("files", [])})

        # 3. plan (todos) — 含清空: todos 变空也要发空列表 (修复 P2.3)
        todos = cur_snapshot.get("todos", []) or []
        sig = json.dumps(todos, ensure_ascii=False, sort_keys=True)
        if sig != self._last_plan_sig:
            self._last_plan_sig = sig
            entries = [{"content": t.get("content", ""),
                        "status": t.get("status", "pending"),
                        "priority": t.get("priority", "medium")}
                       for t in todos]
            events.append({"kind": "PlanUpdate", "entries": entries})

        return events

    def _diff_tool_part(self, p):
        """对比单个 tool part, 产出 ToolCallNew / ToolCallUpdate 事件"""
        events = []
        call_id = p.get("callID") or p.get("callId")
        if not call_id:
            return events
        tool_name = p.get("tool", "other")
        state = p.get("state", {})
        status = state.get("status", "pending")

        if call_id not in self._seen_tool_ids:
            # 新工具调用
            self._seen_tool_ids.add(call_id)
            self._last_tool_status[call_id] = status
            events.append({
                "kind": "ToolCallNew",
                "call_id": call_id,
                "tool": tool_name,
                "status": self.TOOL_STATUS_MAP.get(status, "other"),
                "input": state.get("input"),
                "output": state.get("output") if status in ("completed",) else None,
                "title": f"{tool_name}: {self._summarize_input(state.get('input'))}",
            })
        else:
            # 状态更新
            if status != self._last_tool_status.get(call_id):
                self._last_tool_status[call_id] = status
                update = {
                    "kind": "ToolCallUpdate",
                    "call_id": call_id,
                    "status": self.TOOL_STATUS_MAP.get(status, "other"),
                }
                if status in ("completed", "error"):
                    update["output"] = state.get("output") or state.get("error")
                events.append(update)
        return events

    @staticmethod
    def _summarize_input(inp):
        """生成人类可读的 input 摘要"""
        if inp is None:
            return ""
        if isinstance(inp, dict):
            # 取 command / path / pattern 等关键字段
            for k in ("command", "path", "pattern", "query", "file_path"):
                if k in inp:
                    return str(inp[k])[:60]
            return json.dumps(inp, ensure_ascii=False)[:60]
        return str(inp)[:60]


# ============================================================
# ACP 桥接器主逻辑
# ============================================================
class ACPBridge:
    def __init__(self):
        self.backend = None
        # 映射: ACP sessionId → zcode sessionId (实际上两边格式一致, 但保留映射以防变化)
        self.session_map = {}
        # 当前进行中的 prompt: {acp_prompt_id: {zcode_sid, cancelled, perms_responses}}
        self.pending_turns = {}
        # id 基数提到 10_000_000, 避免与 zcode 主动请求的 id 空间冲突。
        # 整体 review P1-1: 用 itertools.count 取代"读-改-写"的 += 1 — next() 在
        # CPython 下原子, 消除未来跨线程调用 _next_id 的 id 重复竞态 (当前虽全部
        # 串行在主线程, 但原写法无护栏)
        self._id_counter = itertools.count(10_000_001)
        # 整体 review P1-2: stdout 协议帧写锁 — 全文件 stdout 写收进 _write_stdout(),
        # 防未来后台线程写帧时与主循环产生交错的半截 JSON (ACP client 会解析失败)
        self._stdout_lock = threading.Lock()
        # stdin 消息队列: 后台线程把每行 stdin 入队, 主循环/轮询循环从队列取
        # 这解决了 run() 单线程阻塞导致 cancel/permission 响应读不到的问题
        self._inbox = queue.Queue()
        self._stdin_thread = None

    def _next_id(self):
        return next(self._id_counter)

    # 0.16 已删方法 (实测后端返 -32601 Method not found, 规格书 §2)
    # 0.16 已删方法清单 — 与 README/SKILL 的「0.16 已移除」表格标注双处维护,
    # 未来版本增删方法时两边同步 (zcode review P3-2)
    _REMOVED_IN_016 = frozenset({
        "session/steer", "session/rewind", "session/rewindCascade",
        "prompt/enhance", "prompt/enhance/start", "prompt/enhance/cancel",
    })

    def _backend_v16(self):
        """后端是否为 0.16+ 新协议 (ZCodeBackend 启动探测缓存; 测试桩无该属性按旧协议)。"""
        return getattr(self.backend, "protocol_mode", "legacy") == "v16"

    def _backend_proc_dead(self):
        """探测 backend 子进程是否已退出 (proc.poll() 非 None = 已死)。

        整体 review P1-3 的收敛探测: 轮询连续无响应时用于区分「后端 hang 但活着」
        (继续等) 与「子进程已死」(确定性故障, 立即报错)。测试桩无 proc 属性时按
        「无法判定」返回 False (不提前收敛, 保持原有等满超时的行为)。
        """
        proc = getattr(self.backend, "proc", None)
        poll = getattr(proc, "poll", None)
        if not callable(poll):
            return False
        try:
            return poll() is not None
        except Exception:
            return False

    def _removed_method_error(self, msg_id, zcode_method, resp):
        """把已删方法的后端 -32601 映射为明确文案 (规格书 §7)。

        不分协议模式: ≤0.15 上这些方法存在, 根本不会返 -32601; 任何版本返了
        -32601 就说明该版本已移除它, 直接给出版本不支持文案。
        文案不硬编码版本号 (zcode review P3-3): 「哪个版本移除」是历史事实,
        对调用方重要的是「当前版本不支持」; 硬编码 0.16 在未来版本再删方法时会误导。
        """
        if (zcode_method in self._REMOVED_IN_016
                and resp.get("error", {}).get("code") == -32601):
            return self._error(msg_id, -32601,
                               f"当前 ZCode 版本已移除该能力 ({zcode_method}); "
                               f"该 ZCode 版本不支持此能力")
        return None

    def ensure_backend(self):
        if self.backend is None:
            self.backend = ZCodeBackend()

    # ---------- ACP 协议层 (对外) ----------

    def handle_acp(self, req):
        """处理来自 ACP client 的一条请求, 返回响应 dict 或 None"""
        method = req.get("method")
        msg_id = req.get("id")

        # notification (无 id) 不需要响应
        if msg_id is None and method and method.startswith("notifications/"):
            return None

        if method == "initialize":
            return self._on_initialize(msg_id, req.get("params", {}))

        if method == "session/new":
            return self._on_session_new(msg_id, req.get("params", {}))

        if method == "session/prompt":
            return self._on_session_prompt(msg_id, req.get("params", {}))

        if method == "session/cancel":
            return self._on_session_cancel(req.get("params", {}))

        if method == "session/list":
            return self._on_session_list(msg_id, req.get("params", {}))

        if method == "session/resume":
            return self._on_session_resume(msg_id, req.get("params", {}))

        # ===== 扩展方法 (非标准 ACP, 透传 zcode 新版协议) =====
        # 这些方法不在 ACP baseline 中, 是 zcode-specific 的能力暴露。
        if method == "session/fork":
            return self._on_session_fork(msg_id, req.get("params", {}))
        if method == "session/rewind":
            return self._on_session_rewind(msg_id, req.get("params", {}))
        if method == "session/goal":
            return self._on_session_goal(msg_id, req.get("params", {}))
        if method == "session/compact":
            return self._on_session_compact(msg_id, req.get("params", {}))
        if method == "session/steer":
            return self._on_session_steer(msg_id, req.get("params", {}))

        # ----- session 级新方法 (0.15.0+, 纯透传) -----
        if method == "session/setThoughtLevel":
            return self._on_session_set_thought_level(msg_id, req.get("params", {}))
        if method == "session/updateRuntimeModelConfig":
            return self._on_session_update_runtime_model_config(msg_id, req.get("params", {}))
        if method == "session/cancelBackgroundTask":
            return self._on_session_cancel_background_task(msg_id, req.get("params", {}))
        if method == "session/rewindCascade":
            return self._on_session_rewind_cascade(msg_id, req.get("params", {}))
        if method == "session/setModel":
            return self._on_session_set_model(msg_id, req.get("params", {}))
        if method == "session/setMode":
            return self._on_session_set_mode(msg_id, req.get("params", {}))

        # ----- workspace/* 方法 (0.15.0+, 按 workspace 选择器定位) -----
        if method == "workspace/readState":
            return self._on_workspace_read_state(msg_id, req.get("params", {}))
        if method == "workspace/generateText":
            return self._on_workspace_generate_text(msg_id, req.get("params", {}))
        if method == "workspace/setDefaultModel":
            return self._on_workspace_set_default_model(msg_id, req.get("params", {}))
        if method == "workspace/setDefaultMode":
            return self._on_workspace_set_default_mode(msg_id, req.get("params", {}))
        if method == "workspace/setDefaultThoughtLevel":
            return self._on_workspace_set_default_thought_level(msg_id, req.get("params", {}))
        if method == "workspace/upsertModelProvider":
            return self._on_workspace_upsert_model_provider(msg_id, req.get("params", {}))
        if method == "workspace/removeModelProvider":
            return self._on_workspace_remove_model_provider(msg_id, req.get("params", {}))
        if method == "workspace/updateProviderRegistry":
            return self._on_workspace_update_provider_registry(msg_id, req.get("params", {}))

        # ----- prompt/* 方法 (App 3.3.0+, 提示词增强) -----
        # prompt/enhance/result 是 server 推送通知 (非 client 可调), 故不在此分发
        if method == "prompt/enhance":
            return self._on_prompt_enhance(msg_id, req.get("params", {}))
        if method == "prompt/enhance/start":
            return self._on_prompt_enhance_start(msg_id, req.get("params", {}))
        if method == "prompt/enhance/cancel":
            return self._on_prompt_enhance_cancel(msg_id, req.get("params", {}))

        # 未实现的 method
        if method and msg_id is not None:
            return self._error(msg_id, -32601, f"Method not supported: {method}")
        return None

    def _on_initialize(self, msg_id, params):
        """ACP initialize: 协商版本, 声明最小 capability"""
        client_pv = params.get("protocolVersion", ACP_PROTOCOL_VERSION)
        log(f"initialize: client protocolVersion={client_pv}, client={params.get('clientInfo',{}).get('name')}")

        return {
            "jsonrpc": "2.0", "id": msg_id,
            "result": {
                "protocolVersion": ACP_PROTOCOL_VERSION,
                "agentCapabilities": {
                    "loadSession": False,
                    "promptCapabilities": {"image": False, "audio": False, "embeddedContext": False},
                    "mcpCapabilities": {"http": False, "sse": False},
                    "sessionCapabilities": {"list": {}, "resume": {}},
                    "auth": {},
                },
                "agentInfo": BRIDGE_INFO,
                "authMethods": [],
            },
        }

    def _on_session_new(self, msg_id, params):
        """ACP session/new → zcode session/create"""
        self.ensure_backend()
        cwd = params.get("cwd") or os.getcwd()
        # 显式 mode 透传; 缺省用 DEFAULT_ACP_MODE (默认 yolo, 可用环境变量
        # ZCODE_ACP_DEFAULT_MODE 收紧 — 整体 review 安全发现): yolo 跳过工具权限确认,
        # 否则 build 模式下工具调用 turn 会卡在 pendingPermissions (0.15 实测;
        # 0.16 stdio 下工具自动执行, 参数被忽略)
        mode = params.get("mode") or DEFAULT_ACP_MODE
        log(f"session/new: cwd={cwd}, mode={mode}")

        zc_id = self._next_id()
        resp, _ = self.backend.request(zc_id, "session/create", {
            "workspace": {"workspacePath": cwd, "workspaceKey": cwd},
            "mode": mode,
        }, timeout=15)

        if "error" in resp:
            return self._error(msg_id, -32603, f"zcode create failed: {resp['error'].get('message','')}")

        result = resp.get("result", {})
        # sessionId: 0.16.1 实测在 result.session.sessionId; 兼容顶层 result.sessionId
        zcode_sid = result.get("session", {}).get("sessionId") or result.get("sessionId")
        if not zcode_sid:
            return self._error(msg_id, -32603, "zcode create returned no sessionId")

        # 0.16+ 无握手方法, create 直接返回 protocol {name, version} → 记录 (规格书 §2)
        proto = result.get("protocol") or {}
        if proto.get("version") is not None:
            self.backend.protocol_version = proto["version"]
            log(f"  zcode protocol: {proto.get('name', '?')} v{proto['version']}")

        # ACP sessionId: 用 zcode 的或生成一个
        acp_sid = zcode_sid  # 格式兼容, 直接用
        self.session_map[acp_sid] = zcode_sid
        log(f"session/new → {acp_sid}")

        return {"jsonrpc": "2.0", "id": msg_id, "result": {"sessionId": acp_sid}}

    def _on_session_list(self, msg_id, params):
        """ACP session/list → zcode session/list, 转成 ACP SessionInfo[]"""
        self.ensure_backend()
        cwd = params.get("cwd")
        zc_params = {"includeArchived": params.get("includeArchived", False)}
        if cwd:
            zc_params["workspace"] = {"workspacePath": cwd, "workspaceKey": cwd}
        limit = params.get("limit")
        if limit:
            zc_params["limit"] = limit

        zc_id = self._next_id()
        resp, _ = self.backend.request(zc_id, "session/list", zc_params, timeout=15)
        if "error" in resp:
            return self._error(msg_id, -32603, f"zcode list failed: {resp['error'].get('message','')}")

        zc_sessions = resp.get("result", {}).get("sessions", [])
        # 转成 ACP SessionInfo: {sessionId, cwd, title?, updatedAt?}
        acp_sessions = []
        for s in zc_sessions:
            ws = s.get("workspace", {})
            acp_sessions.append({
                "sessionId": s.get("sessionId", ""),
                "cwd": ws.get("workspacePath", ""),
                "title": s.get("title"),
                "updatedAt": self._to_iso(s.get("updatedAt")),
            })
        log(f"session/list → {len(acp_sessions)} sessions")
        return {"jsonrpc": "2.0", "id": msg_id, "result": {"sessions": acp_sessions}}

    def _on_session_resume(self, msg_id, params):
        """ACP session/resume → zcode session/resume, 记录映射"""
        self.ensure_backend()
        target_sid = params.get("sessionId")
        cwd = params.get("cwd") or os.getcwd()
        if not target_sid:
            return self._error(msg_id, -32602, "sessionId required")

        zc_params = {"sessionId": target_sid,
                     "workspace": {"workspacePath": cwd, "workspaceKey": cwd}}
        zc_id = self._next_id()
        resp, _ = self.backend.request(zc_id, "session/resume", zc_params, timeout=15)
        if "error" in resp:
            return self._error(msg_id, -32603, f"zcode resume failed: {resp['error'].get('message','')}")

        # resume 成功: 记录映射 (zcode sessionId 与 ACP 一致)
        self.session_map[target_sid] = target_sid
        log(f"session/resume → {target_sid}")
        return {"jsonrpc": "2.0", "id": msg_id, "result": {}}

    # ---------- 扩展方法 (非标准 ACP, 透传 zcode 新版协议 0.14.8+) ----------
