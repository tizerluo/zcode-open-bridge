    def _on_prompt_enhance_start(self, msg_id, params):
        """prompt/enhance/start → 同名: 异步启动增强 job (阻塞等待 result 通知)。

        params: {workspace, sessionId?, prompt, context?, requestId}
        返回: {enhanced} (completed) / {status:"cancelled"} (被取消)
        失败 (failed) → -32603 带 errorMessage; 超时未收到 result → -32603。

        时序关键: 必须先注册 listener 再发 start (参考 session/prompt "先 subscribe 再 send"),
        否则 start 返回与 result 推送之间的通知会丢。阻塞期间主循环串行不取下条消息,
        故每轮 _drain_enhance_inbox 把 inbox 里的 cancel 转发后端, 使 cancel 在等待期可用。

        0.16 已删除该方法 (后端 -32601) → 映射「该版本不支持」并立即返回, 不进入
        异步等待; 不做本地参数校验 (缺参同样报能力缺失而非 -32602)。
        """
        self.ensure_backend()
        ws, err = self._resolve_workspace(msg_id, params)
        if err:
            return err
        prompt = params.get("prompt", "")
        request_id = params.get("requestId", "")
        zc_params = {"workspace": ws, "prompt": prompt, "requestId": request_id}
        if params.get("sessionId") is not None:
            zc_params["sessionId"] = params["sessionId"]
        if params.get("context") is not None:
            zc_params["context"] = params["context"]
        # 时序: 先注册 listener (确保不丢 result 通知), 再发 start。
        # listener 接口只有真实 ZCodeBackend 有, getattr 兜底 (测试桩没有)。
        result_q, dup_err = None, None
        _reg = getattr(self.backend, "register_enhance_listener", None)
        if callable(_reg):
            result_q, dup_err = _reg(request_id)
        if dup_err:
            return self._error(msg_id, -32602, f"prompt/enhance/start: {dup_err}")
        _unreg = getattr(self.backend, "unregister_enhance_listener", None)
        zc_id = self._next_id()
        resp, _ = self.backend.request(zc_id, "prompt/enhance/start", zc_params, timeout=15)
        if "error" in resp:
            if callable(_unreg):
                _unreg(request_id)
            mapped = self._removed_method_error(msg_id, "prompt/enhance/start", resp)
            if mapped:
                return mapped
            return self._error(msg_id, -32603,
                               f"zcode enhance start failed: {resp['error'].get('message', '')}")
        start_result = resp.get("result", {})
        if not start_result.get("accepted"):
            # zcode 拒绝了 (理论上幂等会返回 accepted:true; 此处兜底)
            if callable(_unreg):
                _unreg(request_id)
            return self._error(msg_id, -32603,
                               f"zcode enhance start not accepted: {start_result}")
        if result_q is None:
            # 无 result listener (测试桩): 等不了 result 通知, 直接返回 start 应答
            return {"jsonrpc": "2.0", "id": msg_id, "result": start_result}
        # 短轮询等待 result 通知。每轮 drain inbox 让中途的 cancel 可用 (主循环串行,
        # 不 drain 则 cancel 卡在 inbox)。总超时默认 120s, ZCODE_ENHANCE_TIMEOUT 可覆盖。
        try:
            enhance_timeout = int(os.environ.get("ZCODE_ENHANCE_TIMEOUT", "120"))
        except ValueError:
            enhance_timeout = 120
        deadline = time.time() + enhance_timeout
        result_params = None
        while time.time() < deadline:
            self._drain_enhance_inbox(request_id)
            try:
                result_params = result_q.get(timeout=0.5)
                break
            except queue.Empty:
                continue
        if callable(_unreg):
            _unreg(request_id)
        if result_params is None:
            return self._error(msg_id, -32603,
                               f"prompt/enhance result 等待超时 ({enhance_timeout}s)")
        status = result_params.get("status")
        if status == "completed":
            enhanced = result_params.get("enhanced", "")
            log(f"prompt/enhance/start → completed (enhanced {len(enhanced)} chars)")
            return {"jsonrpc": "2.0", "id": msg_id,
                    "result": {"enhanced": enhanced}}
        if status == "cancelled":
            log("prompt/enhance/start → cancelled")
            return {"jsonrpc": "2.0", "id": msg_id,
                    "result": {"status": "cancelled"}}
        # failed (或未知 status)
        err_msg = result_params.get("errorMessage", f"enhance job failed (status={status})")
        log(f"prompt/enhance/start → failed: {err_msg}")
        return self._error(msg_id, -32603, f"zcode enhance failed: {err_msg}")

    def _drain_enhance_inbox(self, request_id):
        """阻塞等待 enhance result 期间, 把 inbox 里的 cancel 转发给后端。

        主循环串行, _on_prompt_enhance_start 阻塞时 client 发的 cancel 会卡在 inbox。
        本方法每轮短轮询调用: 匹配 requestId 的 cancel 转发后端并写响应到 stdout,
        其他消息放回 inbox 尾部不吞掉。
        """
        while True:
            try:
                line = self._inbox.get_nowait()
            except queue.Empty:
                break
            line = line.strip()
            if not line:
                continue
            try:
                req = json.loads(line)
            except json.JSONDecodeError:
                continue
            if (req.get("method") == "prompt/enhance/cancel"
                    and req.get("params", {}).get("requestId") == request_id):
                cancel_id = req.get("id")
                cancel_resp = self._on_prompt_enhance_cancel(cancel_id, req.get("params", {}))
                if cancel_id is not None:
                    self._write_stdout(cancel_resp)  # P1-2: 统一加锁写口
                continue
            # 非 cancel: 放回尾部, 不吞掉其他带外消息 (顺序保持)
            self._inbox.put(line)

