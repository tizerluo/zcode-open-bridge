    # ---------- workspace/* 方法 (非标准 ACP, 透传 zcode 0.15.0+ 协议) ----------
    # 这些方法作用于 workspace (工作区), 通过 {workspacePath, workspaceKey} 选择器定位,
    # 与 session 级方法 (按 sessionId) 不同。ZCode 3.2.0 (CLI 0.15.0) 新增。

    def _resolve_workspace(self, msg_id, params):
        """从 ACP params 解析 workspace 选择器。

        zcode 的 workspace 选择器形如 {workspacePath, workspaceKey, workspaceIdentity?},
        其中 workspacePath/workspaceKey 都是路径字符串 (现有 session/create 也这样用,
        见 _on_session_new)。ACP client 可能以下面任一方式传入工作区:

          1. params["workspace"] 已是合法 dict (含 workspacePath) → 直接透传
          2. params["workspacePath"] 或 params["cwd"] → 构造 {workspacePath, workspaceKey}
          3. 都没有 → 用 os.getcwd() 兜底

        Args:
            msg_id: 预留 (当前四级解析总能成功, 不会返回错误响应; 保留参数以与其它
                    handler 签名一致, 且未来若加 workspace 路径校验可直接返回错误)。
        Returns:
            (workspace_dict, None) 成功; 或 (None, error_response) 失败 (返回给 client)。
        """
        ws = params.get("workspace")
        if isinstance(ws, dict) and ws.get("workspacePath"):
            return ws, None
        path = params.get("workspacePath") or params.get("cwd") or os.getcwd()
        return {"workspacePath": path, "workspaceKey": path}, None

    @staticmethod
    def _redact_secret(text):
        """对后端错误消息做最小脱敏, 防止 apiKey 泄漏到 ACP client。

        provider/registry 相关方法 (upsert/remove/updateProviderRegistry) 的入参会
        携带 apiKey。虽然 bridge 透传时不读取其值, 但若 zcode 后端把入参片段回显在
        error.message 里, 原样返回会泄漏。这里用正则遮蔽常见密钥形态:
          - sk- 开头的 OpenAI/Anthropic 风格 key 前缀
          - JSON 里 "value":"..." / "apiKey":{...} 的敏感值
          - 纯 hex (32+) / uuid 形态的无前缀 key (整体 review P2-3 纵深防御:
            provider 用这类 apiKey 且被错误消息原样回显时也能遮蔽)
        保留非敏感部分以便排查。
        """
        if not text:
            return text
        s = re.sub(r'sk-[A-Za-z0-9_-]{6,}', 'sk-***', text)
        s = re.sub(r'("value"\s*:\s*")([^"]{4,})(")', r'\1***\3', s)
        s = re.sub(r'("apiKey"\s*:\s*)("?\{[^}]*\}"?|"[^"]{4,}")',
                   r'\1***', s)
        # uuid (8-4-4-4-12) 与 32+ 位纯 hex 是常见无前缀 key 形态, 一并遮蔽。
        # 取舍说明 (复审 P2-5): 32+ hex 也可能命中 git SHA 等合法内容 — 但本函数
        # 只用于错误消息回显路径, 宁可多遮蔽也不可漏 key。
        s = re.sub(r'\b[0-9a-fA-F]{8}(?:-[0-9a-fA-F]{4}){3}-[0-9a-fA-F]{12}\b',
                   '***', s)
        s = re.sub(r'\b[0-9a-fA-F]{32,}\b', '***', s)
        return s

