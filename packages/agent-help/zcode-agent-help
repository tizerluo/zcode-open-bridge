    print("▼ 第二层: App Server 协议")
    print(f"  {aps['description'][:70]}...")
    print(f"  关键 method: {', '.join(m['method'] for m in aps['key_methods'][:5])}...")
    print(f"  part 类型: {', '.join(aps['part_types'].keys())}\n")

    # ecosystem
    eco = cap["ecosystem"]
    print("▼ 第三层: 开放生态接入")
    for comp in eco["components"]:
        print(f"  [{comp['maturity']}] {comp['name']}: {comp['role']}")
    print(f"  会话存储: {'共享' if eco['session_storage']['shared'] else '独立'} "
          f"({eco['session_storage']['location'][:40]}...)\n")

    # environment
    env = cap.get("environment", {})
    print("▼ 当前环境 (动态探测)")
    print(f"  zcode 版本: {env.get('zcode_version', 'unknown')}")
    print(f"  已装 skill: {env.get('skills_count', 0)} 个")
    print(f"  已装组件: {[k for k, v in env.get('installed_components', {}).items() if v] or '无'}")


def main():
    args = sys.argv[1:]
    if "--help" in args or "-h" in args:
        print(__doc__)
        return 0

    # 诊断: 打印"会注入哪些凭证"(脱敏), 不改 config 即可排查 model/baseURL 来源
    if "--print-injected-env" in args:
        return print_injected_env()

    if "--section" in args:
        idx = args.index("--section")
        # 整体 review P1-3: 末尾无值, 或后随另一个 flag (误把 --xxx 当 section 名),
        # 按用法错误处理并 return 1, 不静默落到全量输出 (脚本调用方会误以为拿到了某节)。
        if idx + 1 >= len(args) or args[idx + 1].startswith("--"):
            print(f"用法错误: --section 需要跟一个 section 名\n"
                  f"可用: {', '.join(list(SECTIONS.keys()) + ['environment'])}",
                  file=sys.stderr)
            return 1
        section = args[idx + 1]
        # 静态 section 直接查 SECTIONS; environment 是动态探测的, 单独处理
        if section == "environment":
            data = discover_environment()
        else:
            data = SECTIONS.get(section)
        if data is not None:
            print(json.dumps(data, indent=2, ensure_ascii=False))
            return 0
        print(f"未知 section: {section}\n可用: {', '.join(list(SECTIONS.keys()) + ['environment'])}",
              file=sys.stderr)
        return 1

    cap = build_full()
    if "--pretty" in args:
        print_pretty(cap)
        return 0

    print(json.dumps(cap, indent=2, ensure_ascii=False))
    return 0


if __name__ == "__main__":
    sys.exit(main())
